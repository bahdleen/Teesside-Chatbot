*.orig

# Importer storage
campuspaddy-ai-importer/storage/raw-html/*
campuspaddy-ai-importer/storage/pdfs/*
campuspaddy-ai-importer/storage/other/*
!campuspaddy-ai-importer/storage/raw-html/.gitkeep
!campuspaddy-ai-importer/storage/pdfs/.gitkeep
